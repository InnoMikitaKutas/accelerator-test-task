# Copy to .env for local dev:  cp env.example .env

# --- Option A (default): talk to the backend directly (cross-origin) ---
# The backend MUST allow-list this dev origin (http://localhost:5173) in its
# APP_BASE_URL CORS list (M5). backend/env.example already sets that.
VITE_API_URL=http://localhost:3000/api/v1

# --- Option B: same-origin via the Vite dev proxy (no CORS at all) ---
# Set VITE_API_URL=/api/v1 instead, and requests to /api + /static are proxied
# to the backend by vite.config.ts. Handy if you can't change backend CORS.
# VITE_API_URL=/api/v1

# Cookieless origin that serves user-uploaded assets (logos, avatars). C1: the
# app renders logoUrl/thumbnailUrl from here via <img> and never inlines SVG.
VITE_ASSET_BASE_URL=http://localhost:3000/static
