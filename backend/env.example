NODE_ENV=development
PORT=3000
# Postgres — app role is a NON-owner, FORCE-RLS-subject role (see drizzle/9999_rls_policies.sql)
DATABASE_URL=postgres://app:app@localhost:5432/training
# System role with BYPASSRLS for background jobs / Super Admin cross-tenant reads (architect review R1)
SYSTEM_DATABASE_URL=postgres://system:system@localhost:5432/training
# Migration/owner role (drizzle-kit) — owns the tables so app/system stay non-owners under FORCE RLS
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/training
# Redis
REDIS_URL=redis://localhost:6379
# JWT (use `openssl rand -base64 48` for real secrets; NEVER commit real values)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CSRF_SECRET=dev-csrf-secret-change-me
# Storage (local disk in dev; s3 in prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/static
# Mailer (console in dev)
MAILER_DRIVER=console
MAIL_FROM="Training Platform <no-reply@training.local>"
APP_BASE_URL=http://localhost:5173
# Token lifetimes (seconds) — NFR-007
VERIFICATION_TOKEN_TTL=86400
RESET_TOKEN_TTL=3600
IMPERSONATION_TTL=3600
APPROVAL_TTL=172800
